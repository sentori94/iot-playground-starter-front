# Configuration de l'application Angular Front-End

# URL de l'API Backend (Spring Boot)
# Exemples selon l'environnement:
#
# Développement local:
# API_URL=http://localhost:8080
#
# Docker Compose local:
# API_URL=http://backend:8080
#
# ECS avec ALB (Application Load Balancer):
# API_URL=https://iot-backend-alb.eu-west-1.elb.amazonaws.com
#
# ECS avec Service Discovery:
# API_URL=http://backend.iot-playground.local:8080
#
# Production avec domaine personnalisé:
# API_URL=https://api.monentreprise.com

API_URL=http://localhost:8080

